{
  "name": "myst-mcp",
  "version": "0.1.0",
  "description": "MCP server for MyST Markdown / Jupyter Book documentation search",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "bin": {
    "myst-mcp": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "myst",
    "mystmd",
    "jupyter-book",
    "mcp",
    "model-context-protocol",
    "docsearch",
    "documentation",
    "search"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@myst-theme/search": "^1.3.1",
    "@myst-theme/search-minisearch": "^1.3.1",
    "minisearch": "^7.2.0",
    "myst-spec": "^0.0.5",
    "myst-spec-ext": "^1.10.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/node": "^22.19.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
